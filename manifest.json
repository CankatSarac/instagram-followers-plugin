{
  "manifest_version": 3,
  "name": "Instagram Unfollower Detective",
  "version": "1.0.0",
  "description": "Discover who doesn't follow you back on Instagram with a sleek, unique interface",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Instagram Unfollower Detective"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}